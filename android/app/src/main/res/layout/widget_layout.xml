<?xml version="1.0" encoding="utf-8"?>
<!--
  COMPACT commute widget. IDs are read by CommuteWidgetProvider.onUpdate — do
  not rename them.

  Phase 36 (D-01/D-02) reworked this layout to fit ONE cell of height. Two
  changes carry that:

  1. The active state is now a single HORIZONTAL row — stats beside the
     buttons, not stacked above them. Stacking is what made two cells
     mandatory; nothing else about the content did.
  2. Vertical padding is 1dp and the circular buttons are 48dp, so the whole
     widget renders in exactly 50dp — the `minResizeHeight` declared in
     `res/xml/widget_info.xml`. That 48dp is the Material minimum touch target
     and is the reason the padding is as thin as it is: the button size is the
     floor, and the padding absorbs what is left.

  The START button came down from 64dp to 48dp for the same reason, with its
  icon and caption scaled to match the pause/stop buttons.

  D-02: `btn_stop_commute` now uses `@drawable/ic_widget_stop` (a square) on
  `@drawable/widget_btn_stop`. It previously drew `@android:drawable/ic_media_ff`
  — the platform FAST-FORWARD glyph — on the record button's oval, which read
  as play.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <!-- IDLE STATE -->
    <LinearLayout
        android:id="@+id/widget_idle_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Circular crimson START button (tap target = whole circle) -->
        <FrameLayout
            android:id="@+id/btn_start_commute"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_btn_record"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="START"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ACTIVE STATE — one row: stats, then pause + stop -->
    <LinearLayout
        android:id="@+id/widget_active_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <!-- STATS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIST"
                    android:textColor="#9A9AAA"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:letterSpacing="0.08" />
                <TextView
                    android:id="@+id/widget_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#5EED9E"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIME"
                    android:textColor="#9A9AAA"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:letterSpacing="0.08" />
                <TextView
                    android:id="@+id/widget_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#8AABCF"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- PAUSE + STOP (icon-only; 48dp touch targets) -->
        <LinearLayout
            android:id="@+id/btn_pause_commute"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_btn_pause"
            android:layout_marginStart="6dp"
            android:elevation="2dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_media_pause"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_stop_commute"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_btn_stop"
            android:layout_marginStart="6dp"
            android:elevation="2dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_widget_stop"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
